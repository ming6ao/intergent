#!/usr/bin/env python3
"""Executable shim so the CLI works without installation: ``./bin/sliceme``."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from sliceme.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
